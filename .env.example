# Google Gemini API Key (Required)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database URL
# Host port is 5433 to avoid clashing with a locally installed PostgreSQL.
DATABASE_URL=postgresql+asyncpg://docqa:docqa_secret@localhost:5433/docqa

# Set to 'production' to make the app refuse insecure defaults on startup
APP_ENV=development

# JWT Security
JWT_SECRET=change_me_to_a_secure_random_secret_in_production
JWT_EXPIRATION_MINUTES=1440

# Application Settings
LLM_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-001
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
MIN_RELEVANCE_SCORE=0.60
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=20

# Rate limits (per minute). In-process only — see README for the multi-replica caveat.
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=10

# Storage paths. Leave unset to use absolute defaults inside backend/.
# If you do set them, prefer absolute paths: a relative path resolves against the
# process working directory, so the index moves if you start the app elsewhere.
# CHROMA_PERSIST_DIR=/absolute/path/to/chroma_data
# UPLOAD_DIR=/absolute/path/to/uploads
